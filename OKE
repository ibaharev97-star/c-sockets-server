#define WIN32_LEAN_AND_MEAN
#include <WinSock2.h>
#include <WS2tcpip.h>
#include <iostream>
#include <string>
#pragma comment(lib, "ws2_32.lib")

using namespace std;

int main() {
    setlocale(LC_ALL, "RU");
    SOCKET serverSocket= INVALID_SOCKET;
    SOCKET acceptSocket = INVALID_SOCKET;
    
    int port = 5555;
    WSADATA wsaData;
    int wsaerr;
    WORD wVersionRequested = MAKEWORD(2, 2);

    wsaerr = WSAStartup(wVersionRequested, &wsaData);
    if (wsaerr != 0) {
        cout << "Ошибка WSAStartup: " << wsaerr << endl;
        return 1;
    }
    cout << "WSAStartup OK, статус: " << wsaData.szSystemStatus << endl;

    cout << "==== Step 2 - Поднимаем сокет ====" << endl;
    serverSocket = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (serverSocket == INVALID_SOCKET) {
        cout << "Ошибка сокета: " << WSAGetLastError() << endl;
        WSACleanup();
        return 1;
    }
    cout << "Сокет в порядке" << endl;

    cout << "==== Step 3 - Биндим сокет ====" << endl;
    sockaddr_in service{};
    service.sin_family = AF_INET;
    service.sin_port = htons(port);
    InetPtonA(AF_INET, "127.0.0.1", &service.sin_addr);

    if (bind(serverSocket, (SOCKADDR*)&service, sizeof(service)) == SOCKET_ERROR) {
        cout << "Ошибка bind: " << WSAGetLastError() << endl;
        closesocket(serverSocket);
        WSACleanup();
        return 1;
    }
    cout << "bind OK" << endl;

    cout << "=== Step 4 - Слушаем ===" << endl;
    if (listen(serverSocket, 1) == SOCKET_ERROR) {
        cout << "Ошибка listen: " << WSAGetLastError() << endl;
        closesocket(serverSocket);
        WSACleanup();
        return 1;
    }
    cout << "listen OK. Ждём клиента на 127.0.0.1:" << port << endl;

    cout << "=== Step 5 - accept ===" << endl;
    serverSocket = accept(serverSocket, NULL, NULL);
    if (serverSocket == INVALID_SOCKET) {
        cout << "accept failed: " << WSAGetLastError() << endl;
        closesocket(serverSocket);
        WSACleanup();
        return 1;
    }
    cout << "Клиент подключился!" << endl;

    // Читаем данные
  

    cout << "===step 6 =====" << endl;


    while (true)
    {


        char buffserve[200] = { 0 };

        auto op = recv(serverSocket, buffserve, 200, 0);

        cout << endl << "message from client = " << op << endl;

        if (op > 0)
        {
            cout << "Сообщение получено:" << buffserve << endl << endl << "================";
        }

    }

    //closesocket(acceptSocket);
    //closesocket(serverSocket);
    WSACleanup();

    system("pause");
    return 0;
}









