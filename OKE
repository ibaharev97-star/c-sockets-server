 #define _WIN32_WINNT 0x0601
#include <iostream>
#include <cstring>
#include <winsock2.h>
#include <ws2tcpip.h>
#pragma comment(lib, "ws2_32.lib")

using namespace std;

int main() {
    setlocale(LC_ALL, "RU");

    WSADATA w;
    int err = WSAStartup(MAKEWORD(2, 2), &w);
    if (err != 0) {
        cout << "WSAStartup failed: " << err << endl;
        system("pause");
        return 1;
    }
    cout << "WSAStartup OK: " << w.szSystemStatus << endl;

    SOCKET c = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (c == INVALID_SOCKET) {
        cout << "socket failed: " << WSAGetLastError() << endl;
        WSACleanup();
        system("pause");
        return 1;
    }

    sockaddr_in a{};
    a.sin_family = AF_INET;
    a.sin_port = htons(5555);
    InetPtonA(AF_INET, "127.0.0.1", &a.sin_addr);

    cout << "Connecting to 127.0.0.1:5555..." << endl;
    if (connect(c, (SOCKADDR*)&a, sizeof(a)) == SOCKET_ERROR) {
        int e = WSAGetLastError();
        cout << "connect failed: " << e << endl;
        if (e == 10061) cout << "  -> сервер не запущен или не слушает порт" << endl;
        if (e == 10060) cout << "  -> таймаут (файрвол?)" << endl;
        closesocket(c);
        WSACleanup();
        system("pause");
        return 1;
    }
    cout << "Connected!" << endl;

    const char* msg = "Hello from client";
    int sent = send(c, msg, (int)strlen(msg), 0);
    if (sent == SOCKET_ERROR) {
        cout << "send failed: " << WSAGetLastError() << endl;
    }
    else {
        cout << "Sent bytes: " << sent << endl;
    }

    cout << "===== step 4 =====" << endl;

    while (true) {

        char buffer[200] = { 0 };

        cout << "Введите сообщение для отправки на сервер:";
        cin.getline(buffer, 200);

        auto bytesend = send(c, buffer, 200, 0);





        if (bytesend > 200)
        {
            cout << "Счетчик больше разрешаемого обьема";
        }
        else
        {
            cout << "Your message: " << buffer << endl;
        }


        cout << "==== step 5 ======" << endl;
    }

    //closesocket(c);
    WSACleanup();
    system("pause");
    return 0;
}
